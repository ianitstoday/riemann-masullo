+/-- Paper: Theorem 7.3.1.6(4), p. 345.
+A Fourier-biorthogonal family exists, and its seminorms grow at most polynomially along
+the lattice of centers through any pole to which the chosen place contributes, uniformly
+over the derivative orders. The lattice is based at the pole. -/
+theorem sLocalFourierOrbital_biorthogonal_growth_of_pole
+    (p : Vℚ) (ω : PontryaginDual J₁) (_hPic : PicTrivial)
+    (v : S) (_hv : v.val ∈ Sₚ(p)) (c₀ : Xₛ)
+    (_hc₀ : ∃ j : Idx(p, ω), j.val.1 = c₀ ∧ v ∈ sLocalFinitePolePlaces c₀) :
+    ∃ ψ : Idx(p, ω) → Q(p, ω),
+      (∀ (i j : Idx(p, ω)) (x : Θₛ(ω)), π(p, ω) x = ψ j →
+        sLocalOrbitalFourierJet (F := F) (S := S) (T := Sₚ(p)) (ω := ω) i x =
+          if i = j then 1 else 0) ∧
+      ∀ q : Seminorm ℂ Q(p, ω), Continuous q →
+        ∃ d : ℕ, ∃ C > (0 : ℝ), ∀ (n : ℤ) (j : Idx(p, ω)),
+          j.val.1 = twistₛ c₀ ((((n : ℝ) * period(v) : ℝ) : ℂ) * Complex.I) →
+          q (ψ j) ≤ C * (1 + |(n : ℝ)|) ^ d := by
+  classical
+  obtain ⟨j₀, hj₀, hv₀⟩ := _hc₀
+  have hp : (Sₚ(p)).Nonempty := ⟨v.val, _hv⟩
+  rcases sLocalOrbitalIndex_enumerable_or_empty (F := F) (S := S) p ω hp _hPic with ⟨⟨σ⟩⟩ | ⟨hE, -⟩
+  swap
+  · exact (hE.false j₀).elim
+  obtain ⟨D, ψ, _, _, hD, _, _, hb, _⟩ :=
+    sLocalFourierOrbital_bases (F := F) (S := S) p ω hp _hPic σ
+  have hψ : ∀ (i j : Idx(p, ω)) (x : Θₛ(ω)), π(p, ω) x = ψ j →
+      sLocalOrbitalFourierJet (F := F) (S := S) (T := Sₚ(p)) (ω := ω) i x =
+        if i = j then 1 else 0 := by
+    intro i j x hx
+    have h := hb.1 (σ.symm i) (σ.symm j)
+    simp only [Function.comp_apply, Equiv.apply_symm_apply] at h
+    rw [← hD i x, hx]
+    by_cases hij : i = j
+    · subst hij
+      simpa using h
+    · have hne : σ.symm i ≠ σ.symm j := fun e ↦ hij (σ.symm.injective e)
+      simpa [hij, hne] using h
+  refine ⟨ψ, hψ, fun q hq ↦ ?_⟩
+  obtain ⟨χ, s, hs⟩ := exists_sLocalNormTwist (F := F) (S := S) c₀
+  obtain ⟨ϖ, hϖ⟩ := (Valued.v : Valuation (v.val.adicCompletion F)
+    (WithZero (Multiplicative ℤ))).exists_isUniformizer_of_isCyclic_of_nontrivial
+  let u : (v.val.adicCompletion F)ˣ := Units.mk0 (ϖ : v.val.adicCompletion F) hϖ.ne_zero
+  have hu := norm_uniformizer_adicCompletion v.val (ϖ : v.val.adicCompletion F) hϖ
+  obtain ⟨t, ht⟩ := (existsUnique_sLocalOrbitalPhase χ v u hu).exists
+  obtain ⟨m, hm⟩ := (existsUnique_sLocalOrbitalLatticeIndex χ v u hu t ht c₀
+    ⟨s, hs.symm⟩ hv₀).exists
+  obtain ⟨d, C, hC, hbd⟩ :=
+    sLocalFourierOrbital_growth_of_periodic p χ ω v t hp _hPic _hv ψ hψ q hq
+  refine ⟨d, C * (1 + |(m : ℝ)|) ^ d, by positivity, fun n j hj ↦ ?_⟩
+  obtain ⟨k, hk⟩ : ∃ k : ℤ, k = m + n := ⟨_, rfl⟩
+  have hlat : j.val.1 = lattice(χ, v, t, k) := by
+    rw [hj, hm, normTwist_normTwist, hk]
+    congr 1
+    push_cast
+    ring
+  have hpole : v ∈ sLocalFinitePolePlaces j.val.1 := by
+    rw [hj]
+    refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
+    have he : (fun w : ℂ ↦ finiteLocalEulerFactor v.val (sLocalFiniteRestriction v
+        (twistₛ (twistₛ c₀ ((((n : ℝ) * period(v) : ℝ) : ℂ) * Complex.I)) w))) =
+        fun w : ℂ ↦ finiteLocalEulerFactor v.val (sLocalFiniteRestriction v (twistₛ c₀ w)) :=
+      funext fun w ↦ sLocalOrbitalFinitePole_periodic v c₀ n w
+    rw [he]
+    exact (Finset.mem_filter.mp hv₀).2
+  have hbound := hbd k j hlat hpole
+  subst hk
+  refine hbound.trans ?_
+  rw [mul_assoc, ← mul_pow]
+  apply mul_le_mul_of_nonneg_left _ hC.le
+  apply pow_le_pow_left₀ (by positivity)
+  push_cast
+  nlinarith [abs_add_le (m : ℝ) (n : ℝ), mul_nonneg (abs_nonneg (m : ℝ)) (abs_nonneg (n : ℝ))]
 
+end UnsaturatedStage
