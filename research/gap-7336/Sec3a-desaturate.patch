+/-- Integer imaginary twists by the local period preserve the Euler factor of the place. -/
+private theorem sLocalOrbitalFinitePole_periodic (v : S) (c : Xₛ) (n : ℤ) (w : ℂ) :
+    finiteLocalEulerFactor v.val (sLocalFiniteRestriction v
+      (twistₛ (twistₛ c ((((n : ℝ) * period(v) : ℝ) : ℂ) * Complex.I)) w)) =
+    finiteLocalEulerFactor v.val (sLocalFiniteRestriction v (twistₛ c w)) := by
+  obtain ⟨k, rfl | rfl⟩ := n.eq_nat_or_neg
+  · have h := sLocalOrbitalIndex_enumerable_or_empty_periodic v (twistₛ c w) k
+    simpa only [normTwist_normTwist, add_comm, Int.cast_natCast] using h
+  · have h := sLocalOrbitalIndex_enumerable_or_empty_periodic v
+      (twistₛ (twistₛ c ((((-(k : ℤ) : ℤ) : ℝ) * period(v) : ℝ) * Complex.I)) w) k
+    rw [← h]
+    simp only [normTwist_normTwist]
+    congr 3
+    push_cast
+    ring
